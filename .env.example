# =============================================================================
# OPCIONAL — preferência: grave o firebaseConfig em:
#   src/firebase/projectConfig.ts
# Assim TODO usuário conecta automaticamente sem configurar nada.
#
# Se quiser usar variáveis de ambiente no build, copie este arquivo para
# .env.local (não commitar) e preencha.
# =============================================================================

GEMINI_API_KEY=

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
