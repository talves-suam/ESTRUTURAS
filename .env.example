# =============================================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite .env.local (já está no .gitignore).
# =============================================================================

# --- Segredo de servidor (NÃO use prefixo VITE_) ---
# Se usar Gemini no futuro, chame a API só no backend/proxy.
# Prefixo VITE_ expõe a variável no JavaScript do browser.
GEMINI_API_KEY=

# --- Firebase (cliente) ---
# A API Key web do Firebase é pública por design.
# Ainda assim: não versionar valores reais; restrinja por domínio no Console.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
