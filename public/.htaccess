# SPA Estruturas Curriculares — servir estáticos sem o router PHP das outras apps
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env)(\..+)?$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia arquivos de ambiente e config MySQL se expostos na raiz
    RewriteRule (^|/)\.env - [F,L]
    RewriteRule (^|/)api/config\.php$ - [F,L]

    # Arquivo ou pasta existente: servir direto (assets/*.js, *.css, imagens)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Demais rotas → entrada PHP (que entrega o index.html do SPA)
    RewriteRule ^ index.php [L]
</IfModule>
