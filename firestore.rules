rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueado por padrão: o app funciona com localStorage sem Firestore aberto.
    // Antes de publicar online, implemente autenticação e regras por usuário, por exemplo:
    //   allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
