rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Time interno UNISUAM: qualquer pessoa com o app lê e grava o mesmo banco.
    // Troque por autenticação (request.auth != null) quando o acesso precisar ser restrito.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
