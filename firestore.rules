rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de teste (time interno). O login do app já restringe quem entra.
    // Quando Auth Google estiver estável para todo o time, troque por isUnisuam().
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
